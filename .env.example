# Server-only Supabase project URL.
SUPABASE_URL=https://your-project.supabase.co

# Server-only value: do not expose it in browser code or commit .env.local.
SUPABASE_API_KEY=

# Required in the Telegram authentication phase.
TELEGRAM_BOT_TOKEN=

# Random server-only secret used to validate Telegram webhook requests.
TELEGRAM_WEBHOOK_SECRET=
